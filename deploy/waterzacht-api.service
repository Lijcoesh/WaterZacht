# /etc/systemd/system/waterzacht-api.service
[Unit]
Description=WaterZacht API
After=network.target

[Service]
User=waterzacht
WorkingDirectory=/var/www/waterzacht/api
ExecStart=/usr/bin/dotnet /var/www/waterzacht/api/WaterZacht.API.dll
Restart=always
RestartSec=5

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=Api__TrustedProxyNetworks__0=127.0.0.1/32
# Brevo__ApiKey en Brevo__SenderEmail (alleen leesbaar voor root)
EnvironmentFile=/etc/waterzacht/api.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

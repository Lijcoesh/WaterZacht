{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "TrustedProxyNetworks": []
  },
  "Mail": {
    "QuoteRequestRecipient": "info@waterzacht.nl",
    "SaltOrderRecipient": "zout@waterzacht.nl"
  },
  "RateLimit": {
    "QuoteRequestPermitLimit": 5,
    "QuoteRequestWindowSeconds": 3600,
    "SaltOrderPermitLimit": 5,
    "SaltOrderWindowSeconds": 3600,
    "SaltOrderPerEmailPermitLimit": 3,
    "SaltOrderPerEmailWindowSeconds": 3600
  },
  "Brevo": {
    "BaseUrl": "https://api.brevo.com",
    "SenderName": "Water Zacht",
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 1000
  }
}
